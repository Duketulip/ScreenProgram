<Window x:Class="ShowPlayer.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级设置" Width="480" Height="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F0F0" Padding="8" CornerRadius="3" Margin="0,0,0,8">
            <TextBlock Text="转场与画面" FontWeight="Bold" FontSize="12"/>
        </Border>

        <Grid Grid.Row="1" Margin="10,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="转场类型:" VerticalAlignment="Center" FontSize="11"/>
            <ComboBox Grid.Column="1" x:Name="TransitionTypeBox" FontSize="11" Height="24">
                <ComboBoxItem Content="淡入淡出 (Fade)" Tag="Fade" IsSelected="True"/>
                <ComboBoxItem Content="直接切换 (Direct)" Tag="Direct"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="10,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="转场时长:" VerticalAlignment="Center" FontSize="11"/>
            <Slider Grid.Column="1" x:Name="DurationSlider" Minimum="100" Maximum="3000"
                    TickFrequency="100" IsSnapToTickEnabled="True" Value="500"
                    Margin="5,0"/>
            <TextBlock Grid.Column="2" x:Name="DurationLabel" Text="500ms" Width="50"
                       VerticalAlignment="Center" FontSize="11" Foreground="#555"/>
        </Grid>

        <Border Grid.Row="3" Background="#F0F0F0" Padding="8" CornerRadius="3" Margin="0,8,0,8">
            <TextBlock Text="音量" FontWeight="Bold" FontSize="12"/>
        </Border>

        <Grid Grid.Row="4" Margin="10,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="视频音量:" VerticalAlignment="Center" FontSize="11"/>
            <Slider Grid.Column="1" x:Name="VideoVolumeSlider" Minimum="0" Maximum="100" Value="100"
                    TickFrequency="10" IsSnapToTickEnabled="True" Margin="5,0"/>
            <TextBlock Grid.Column="2" x:Name="VideoVolumeLabel" Text="100" Width="30"
                       VerticalAlignment="Center" FontSize="11" Foreground="#555"/>
        </Grid>

        <Grid Grid.Row="5" Margin="10,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="音乐音量:" VerticalAlignment="Center" FontSize="11"/>
            <Slider Grid.Column="1" x:Name="MusicVolumeSlider" Minimum="0" Maximum="100" Value="100"
                    TickFrequency="10" IsSnapToTickEnabled="True" Margin="5,0"/>
            <TextBlock Grid.Column="2" x:Name="MusicVolumeLabel" Text="100" Width="30"
                       VerticalAlignment="Center" FontSize="11" Foreground="#555"/>
        </Grid>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="80" Height="30" Click="OnOk" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="30" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
