<Window x:Class="ShowPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="会场大屏播放控制 - 中控台"
        Width="940" Height="680"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBg}" Padding="6"
                CornerRadius="4" Margin="0,0,0,4" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="添加文件" Command="{Binding AddFilesCommand}" Width="80" Height="26" Margin="0,0,4,0" FontSize="11"/>
                    <Button Content="清空列表" Command="{Binding ClearAllCommand}" Width="70" Height="26" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding ShowNowPlayingInfo, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="{Binding NowPlayingDisplayName}" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding ShowNowPlayingInfo, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,1,1,0"
                        CornerRadius="4,4,0,0" Background="{DynamicResource HeaderBg}" Padding="6">
                    <TextBlock Text="播放列表（拖拽可排序）" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding CurrentItem}"
                         BorderThickness="1,0,1,0"
                         BorderBrush="{DynamicResource PanelBorder}"
                         Background="{DynamicResource WindowBg}"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="OnListBoxPreviewMouseLeftButtonDown"
                         PreviewMouseMove="OnListBoxPreviewMouseMove"
                         Drop="OnListBoxDrop"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,2,2,2" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="▶" FontSize="9"
                                           Foreground="#4CAF50" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding IsNowPlaying, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Border Grid.Column="1" Width="24" Height="24"
                                        Background="{DynamicResource ItemBg}" CornerRadius="2"
                                        BorderBrush="{Binding IsMissing, Converter={StaticResource MissingBorderConverter}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Type}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="9"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Margin="4,0,0,0"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3" Content="✕" Width="20" Height="20" FontSize="9"
                                        Foreground="#E55" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="删除"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,1,0"
                        Background="{DynamicResource SubPanelBg}" Padding="6"
                        Visibility="{Binding ShowNowPlayingInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="🎵 播放控制" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>
                        <Border Background="{DynamicResource PreviewBg}" Height="40" CornerRadius="3"
                                BorderBrush="#333" BorderThickness="1" Margin="0,0,0,4">
                            <Grid>
                                <TextBlock Text="无播放内容" Foreground="{DynamicResource PreviewSubText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                                           Visibility="{Binding ShowNowPlayingInfo, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding NowPlayingDisplayName}"
                                           Foreground="{DynamicResource PreviewText}"
                                           FontSize="10" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"
                                           Visibility="{Binding ShowNowPlayingInfo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <Button Content="⏮ 上一个" Width="68" Height="24" FontSize="10"
                                    Command="{Binding PreviousCommand}" Margin="0,0,4,0"/>
                            <Button Content="{Binding PlayPauseButtonText}" Width="68" Height="24" FontSize="10"
                                    Command="{Binding PauseResumeCommand}" Margin="0,0,4,0"/>
                            <Button Content="⏹ 停止" Width="56" Height="24" FontSize="10"
                                    Command="{Binding StopCommand}" Margin="0,0,4,0"/>
                            <Button Content="⏭ 下一个" Width="68" Height="24" FontSize="10"
                                    Command="{Binding NextCommand}"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,0"
                              Visibility="{Binding IsNowPlayingVideo, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding VideoTimeText}" FontSize="9"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding VideoProgress}"
                                    SmallChange="0.01" LargeChange="0.05" Height="14" Margin="0"
                                    IsSnapToTickEnabled="False"
                                    PreviewMouseDown="OnSliderPreviewMouseDown"
                                    PreviewMouseUp="OnSliderPreviewMouseUp"
                                    ValueChanged="OnSliderValueChanged"/>
                            <TextBlock Grid.Column="2" Text="{Binding VideoDurationText}" FontSize="9"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                        CornerRadius="0,0,4,4" Background="{DynamicResource SubPanelBg}" Padding="6">
                    <StackPanel>
                        <TextBlock Text="⚙ 全局设置" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="转场" FontSize="9"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                <RadioButton Content="淡入" IsChecked="{Binding UseDirectTransition, Converter={StaticResource InverseBoolConverter}}"
                                             FontSize="9" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0"/>
                                <RadioButton Content="直接" IsChecked="{Binding UseDirectTransition}"
                                             FontSize="9" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="默认图片" FontSize="9"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DefaultIdleImageDisplayName, TargetNullValue='未设置'}"
                                       FontSize="9" Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="选择" Width="36" Height="18" FontSize="8"
                                    Command="{Binding SelectIdleImageCommand}"
                                    Background="{DynamicResource BtnDefault}" BorderThickness="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,4"
                              Visibility="{Binding UseDirectTransition, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="淡入时长" FontSize="9"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="100" Maximum="3000"
                                    TickFrequency="200" IsSnapToTickEnabled="True"
                                    Value="{Binding TransitionDurationMs}"
                                    Height="14" Margin="2,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding TransitionDurationText}" Width="36"
                                       FontSize="9" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="视频音量" FontSize="9"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VideoVolume}"
                                    Height="14" Margin="2,0"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="音乐音量" FontSize="9"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MusicVolume}"
                                    Height="14" Margin="2,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                    CornerRadius="4" Background="{DynamicResource WindowBg}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="{DynamicResource WindowBg}">
                    <StackPanel Margin="5">
                        <Border Background="{DynamicResource SubPanelBg}" CornerRadius="3" Padding="5" Margin="0,0,0,6"
                                BorderBrush="{DynamicResource SubPanelBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📋 选中项" FontWeight="Bold" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedItemDisplayName, TargetNullValue='（未选中）'}"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" Margin="2,0,0,2"/>
                                <Button Content="▶ 从此项开始播放" FontSize="9" Height="20"
                                        Visibility="{Binding ShowSelectedPlayButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding PlayItemCommand}" CommandParameter="{Binding CurrentItem}"
                                        Margin="0,0,0,4" HorizontalAlignment="Left" Padding="6,0"/>
                                <CheckBox Content="视频循环播放" IsChecked="{Binding SelectedVideoLoop}"
                                          FontSize="10" Margin="2,0,0,2"
                                          Foreground="{DynamicResource TextPrimary}"
                                          Visibility="{Binding IsSelectedItemVideo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Border Background="{DynamicResource FieldBg}" CornerRadius="2" Padding="4"
                                        BorderBrush="{DynamicResource SubPanelBorder}" BorderThickness="1"
                                        Visibility="{Binding IsSelectedItemImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="背景音乐" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <Button Content="选择音乐" Width="65" Height="20" FontSize="9"
                                                    Command="{Binding SelectMusicCommand}" Margin="0,0,3,0"/>
                                            <Button Content="清除" Width="45" Height="20" FontSize="9"
                                                    Command="{Binding ClearMusicCommand}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedMusicFileName}" FontSize="9"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="230"
                                                   Visibility="{Binding SelectedHasMusic, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <CheckBox Content="音乐循环" IsChecked="{Binding SelectedMusicLoop}"
                                                  FontSize="9" Margin="0,1,0,0"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  Visibility="{Binding SelectedHasMusic, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="{DynamicResource StatusBarBg}" Padding="4" Margin="0,4,0,0"
                   BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="TimeText" Text="--:--:--" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock Text="{Binding Items.Count, StringFormat='总计: {0} 项'}" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <Button Content="{Binding ShowWindowToggleText}" Height="22" FontSize="10"
                        Command="{Binding ToggleShowWindowCommand}"
                        Background="{DynamicResource BtnDefault}" BorderThickness="1"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
