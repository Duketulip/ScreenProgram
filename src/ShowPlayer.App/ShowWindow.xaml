<Window x:Class="ShowPlayer.App.ShowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="展示窗口"
        WindowStyle="None"
        Background="Black"
        WindowState="Normal"
        ShowInTaskbar="True"
        Topmost="False"
        ResizeMode="CanResizeWithGrip"
        Width="960" Height="540"
        MinWidth="400" MinHeight="225"
        MouseDoubleClick="OnContentDoubleClick">
    <Grid x:Name="RootGrid" Background="Black">
        <Border x:Name="ContentBorder" BorderThickness="0" Panel.ZIndex="1" Margin="0,32,0,0">
            <Grid>
                <Image x:Name="ContentImage" Stretch="Uniform" Visibility="Collapsed"/>
                <vlc:VideoView x:Name="ContentVideo" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border x:Name="FadeOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="10"/>

        <Border x:Name="TitleBar"
                Height="32"
                VerticalAlignment="Top"
                Background="#CC000000"
                Panel.ZIndex="20"
                Padding="6,0"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🎬" Foreground="#AAA" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="1" x:Name="TitleFileName" Text="" Foreground="#DDD" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PinBtn" Content="📌" Width="26" Height="22" FontSize="10"
                        Foreground="#AAA" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="窗口置顶" Click="OnToggleTopmost" Margin="2,0"/>
                <Button Grid.Column="3" Content="⛶" Width="26" Height="22" FontSize="11"
                        Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="全屏" Click="OnToggleFullscreen" Margin="2,0"/>
                <Button Grid.Column="4" Content="⎯" Width="26" Height="22" FontSize="11"
                        Foreground="#AAA" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="最小化" Click="OnMinimize" Margin="2,0"/>
                <Button Grid.Column="5" Content="⎯" Width="26" Height="22" FontSize="11"
                        Foreground="#CCC" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="最小化到托盘" Click="OnMinimize" Margin="2,0"/>
            </Grid>
        </Border>

        <Border x:Name="FullscreenHint"
                Height="40" VerticalAlignment="Top"
                Background="#80000000" Panel.ZIndex="20" Visibility="Collapsed">
            <TextBlock Text="按 Esc 退出全屏 · 鼠标移到顶部显示控制栏" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
        </Border>
    </Grid>
</Window>
